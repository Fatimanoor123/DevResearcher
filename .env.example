# ============================================================
# DevResearcher Backend — environment variables
# ============================================================
#
# Copy this file to .env for local development, or configure these
# as service variables in Railway. None of these are required for
# the API to boot, but they enable database persistence and correct
# cross-origin behaviour once the frontend is deployed separately.

# --------------------------------------------------------------
# Network
# --------------------------------------------------------------

# Port the server listens on. Railway injects this automatically —
# you normally do not need to set it yourself.
PORT=8000

# Interface to bind to. Defaults to 0.0.0.0 so the container accepts
# external connections; only override for local-only testing.
HOST=0.0.0.0

# --------------------------------------------------------------
# Database
# --------------------------------------------------------------

# Connection string for the application database, e.g. the value
# Railway's PostgreSQL plugin exposes as DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/devresearcher

# --------------------------------------------------------------
# Cross-service / CORS
# --------------------------------------------------------------

# Public URL of the deployed frontend (React/Vite), used to allow
# cross-origin requests from that origin.
FRONTEND_URL=https://your-frontend.up.railway.app

# Public domain Railway assigns to this backend service. Set
# automatically by Railway; used to build the CORS allow-list.
RAILWAY_PUBLIC_DOMAIN=your-backend.up.railway.app
